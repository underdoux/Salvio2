# Redirect all requests to public directory
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^$ public/ [L]
    RewriteRule (.*) public/$1 [L]
</IfModule>

# Deny access to sensitive files
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

<FilesMatch "(composer\.json|composer\.lock|package\.json|package-lock\.json|README\.md|\.gitignore|\.env)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Deny access to sensitive directories
<DirectoryMatch "^/.*/(?:config|migrations|seeders|storage|tests)/">
    Order allow,deny
    Deny from all
</DirectoryMatch>
