[Unit]
Description=POS Pharma Notification Processor
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/path/to/Salvio2/Salvio2
ExecStart=/usr/bin/php /path/to/Salvio2/Salvio2/scripts/process_notifications.php --verbose
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
